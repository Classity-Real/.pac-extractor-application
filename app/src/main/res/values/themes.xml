<resources>
    <style name="Theme.PExt" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#1C1C1C</item>
        <item name="android:statusBarColor">#1C1C1C</item>
        <item name="android:navigationBarColor">#1C1C1C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.PExt.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1C1C1C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.PExt</item>
    </style>
</resources>
